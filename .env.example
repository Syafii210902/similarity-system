# =============================================================
# Konfigurasi docker-compose (salin menjadi .env lalu isi).
# File .env TIDAK boleh di-commit.
# =============================================================

# Kunci enkripsi Laravel. Isi dengan keluaran:
#   docker compose exec laravel php artisan key:generate --show
APP_KEY=

# Database MySQL (container `db`)
DB_DATABASE=campus_app
DB_USERNAME=campus_user
DB_PASSWORD=secret

# Kunci antar-service (Laravel -> FastAPI dan FastAPI -> webhook Laravel).
# Isi masing-masing dengan string acak 64 karakter, misalnya:
#   openssl rand -hex 32
ANALYSIS_ENGINE_KEY=
ANALYSIS_WEBHOOK_KEY=

# ---- LLM (Tahap 2 & deteksi AI) ------------------------------
# Claude dipakai otomatis bila ANTHROPIC_API_KEY terisi; selain itu Gemini.
# API key Claude dibuat di console.anthropic.com (langganan Claude Pro TIDAK mencakup API).
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Opsional
# LLM_PROVIDER=anthropic          # paksa provider: anthropic | gemini
# CLAUDE_MODEL=claude-opus-5-5
# LLM_EFFORT=low                  # low | medium | high
