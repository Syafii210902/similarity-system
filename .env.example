# =============================================================
# Konfigurasi docker-compose (salin menjadi .env lalu isi).
# File .env TIDAK boleh di-commit.
# =============================================================

# Kunci enkripsi Laravel. Isi dengan keluaran:
#   docker compose exec laravel php artisan key:generate --show
APP_KEY=

# Database MySQL (container `db`)
DB_DATABASE=campus_app
DB_USERNAME=campus_user
DB_PASSWORD=secret

# Kunci antar-service (Laravel -> FastAPI dan FastAPI -> webhook Laravel).
# Isi masing-masing dengan string acak 64 karakter, misalnya:
#   openssl rand -hex 32
ANALYSIS_ENGINE_KEY=
ANALYSIS_WEBHOOK_KEY=

# ---- LLM (Tahap 2 & deteksi AI) ------------------------------
# API key Gemini dibuat di Google AI Studio (aistudio.google.com).
GEMINI_API_KEY=

# Opsional
# GEMINI_MODELS=gemini-3.5-flash-lite  # dicoba berurutan (pisahkan koma); satu model = hasil tidak tercampur
# GEMINI_DELAY_SECONDS=12         # jeda antar-panggilan Gemini; 60 / RPM akun (gratis ±5 RPM -> 12)
# GEMINI_RATE_LIMIT_RETRIES=3     # berapa kali menunggu lalu mencoba lagi saat kena 429
# GEMINI_RATE_LIMIT_WAIT=30       # detik tunggu awal saat 429 (bertambah tiap percobaan)
